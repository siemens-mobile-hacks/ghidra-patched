+	private C166ArrayIndex getC166ArrayIndex(Varnode value, int depth) {
+		if (value == null || depth > 2) {
+			return null;
+		}
+		long stride = getC166ArrayStride(value);
+		if (stride > 0) {
+			return new C166ArrayIndex(stride, 0);
+		}
+		PcodeOp definition = value.getDef();
+		if (definition == null || definition.getOpcode() != PcodeOp.INT_ADD ||
+			definition.getNumInputs() != 2) {
+			return null;
+		}
+		Varnode first = definition.getInput(0);
+		Varnode second = definition.getInput(1);
+		Varnode constant = first.isConstant() ? first : second;
+		Varnode nested = first.isConstant() ? second : first;
+		if (!constant.isConstant() || nested.isConstant()) {
+			return null;
+		}
+		C166ArrayIndex index = getC166ArrayIndex(nested, depth + 1);
+		return index == null ? null :
+			new C166ArrayIndex(index.stride(), index.offset() + getSigned(constant));
+	}
