+	private long getC166ArrayStride(PcodeOp operation, Varnode index) {
+		if (operation == null || operation.getNumInputs() != 2 || operation.getOutput() == null ||
+			operation.getOutput().getSize() != 2) {
+			return -1;
+		}
+		long stride;
+		if (operation.getOpcode() == PcodeOp.INT_MULT) {
+			Varnode first = operation.getInput(0);
+			Varnode second = operation.getInput(1);
+			Varnode constant = first.isConstant() ? first : second;
+			Varnode variable = first.isConstant() ? second : first;
+			if (!constant.isConstant() || variable.isConstant() ||
+				(index != null && variable != index)) {
+				return -1;
+			}
+			stride = constant.getOffset();
+		}
+		else if (operation.getOpcode() == PcodeOp.INT_LEFT) {
+			if (!operation.getInput(1).isConstant() ||
+				(index != null && operation.getInput(0) != index)) {
+				return -1;
+			}
+			long shift = operation.getInput(1).getOffset();
+			if (shift >= 63) {
+				return -1;
+			}
+			stride = 1L << shift;
+		}
+		else {
+			return -1;
+		}
+		return stride >= 2 && stride <= 0x1000 ? stride : -1;
+	}
