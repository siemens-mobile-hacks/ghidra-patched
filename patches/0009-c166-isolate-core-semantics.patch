+TEST(segment_constant_non_c166_not_resolved) {
+  ArchitectureCapability *xmlCapability = ArchitectureCapability::getCapability("xml");
+  istringstream s(
+      "<binaryimage arch=\"x86:LE:16:Protected Mode:default\"></binaryimage>"
+  );
+  DocumentStorage store;
+  Document *doc = store.parseDocument(s);
+  store.registerTag(doc->getRoot());
+  Architecture *arch = xmlCapability->buildArchitecture("","",&cout);
+  arch->init(store);
+
+  ASSERT(!arch->hasProcessorProperty("c166.abi","tasking-classic-large"));
+  AddrSpace *spc = arch->getDefaultDataSpace();
+  SegmentOp *segdef = arch->getSegmentOp(spc);
+  ASSERT(segdef != (SegmentOp *)0);
+  ASSERT(segdef->hasFarPointerSupport());
+
+  Address addr(arch->getDefaultCodeSpace(),0x1000);
+  Funcdata *func = arch->symboltab->getGlobalScope()->addFunction(addr,"segment_control")->getFunction();
+  func->setHighLevel();
+  PcodeOp *op = func->newOp(3,addr);
+  func->opSetOpcode(op,CPUI_SEGMENTOP);
+  func->opSetInput(op,func->newVarnodeSpace(spc),0);
+  func->opSetInput(op,func->newConstant(segdef->getBaseSize(),0x1234),1);
+  func->opSetInput(op,func->newConstant(segdef->getInnerSize(),0x5678),2);
+  func->newUniqueOut(spc->getAddrSize(),op);
+
+  RuleSegment rule("segment");
+  ASSERT_EQUALS(rule.applyOp(op,*func),1);
+  ASSERT_EQUALS(op->code(),CPUI_COPY);
+  ASSERT(!op->getIn(0)->isResolvedPointer());
+  delete arch;
+}
