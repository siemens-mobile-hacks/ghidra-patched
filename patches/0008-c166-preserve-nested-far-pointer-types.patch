+/// Select a complete far-pointer field at an exact byte boundary of a typed
+/// source object.  A four-byte scalar or code pointer is authoritative negative
+/// evidence and suppresses the weaker terminal-use fallback.
+static Datatype *selectC166FarPointerSourceField(Datatype *rootType,uintb offset,
+						 Funcdata &data,SegmentOp *segdef,
+						 bool &hasDeclaredType)
+
+{
+  if (rootType == (Datatype *)0 || rootType->getMetatype() != TYPE_PTR)
+    return (Datatype *)0;
+  int8 fieldOffset = (int8)offset;
+  TypePointer *parent = (TypePointer *)0;
+  int8 parentOffset = 0;
+  TypePointer *fieldAddress = ((TypePointer *)rootType)->downChain(fieldOffset,
+				parent,parentOffset,false,*data.getArch()->types);
+  if (fieldAddress == (TypePointer *)0 || fieldOffset != 0)
+    return (Datatype *)0;
+  Datatype *fieldType = fieldAddress->getPtrTo();
+  if (fieldType->getSize() == segdef->getBaseSize() + segdef->getInnerSize())
+    hasDeclaredType = true;
+  if (getC166TaskingClassicLargeSegment(data,fieldType) != segdef ||
+      ((TypePointer *)fieldType)->getPtrTo()->getMetatype() == TYPE_CODE)
+    return (Datatype *)0;
+  return fieldType;
+}
+
+/// Recover the declared type of a far-pointer field before adjacent OFFSET and
+/// PAGE loads are joined.  The terminal access through the loaded pointer only
+/// describes the accessed value (often one word); the source address describes
+/// the complete four-byte pointer object and therefore provides stronger type
+/// evidence.  If the segmented source has already lost its pointee type, trace
+/// its PAGE/OFFSET inputs back to the typed ABI whole before descending to the
+/// field.
+static Datatype *inferC166FarPointerLoadSourceType(PcodeOp *load,
+						   Funcdata &data,SegmentOp *segdef,
+						   bool &hasDeclaredType)
+
+{
+  hasDeclaredType = false;
+  Varnode *address = load->getIn(1);
+  Datatype *addressType = address->getTypeReadFacing(load);
+  if (addressType->getMetatype() == TYPE_PTR) {
+    Datatype *fieldType = ((TypePointer *)addressType)->getPtrTo();
+    if (getC166TaskingClassicLargeSegment(data,fieldType) == segdef) {
+      hasDeclaredType = true;
+      if (((TypePointer *)fieldType)->getPtrTo()->getMetatype() != TYPE_CODE)
+	return fieldType;
+      return (Datatype *)0;
+    }
+  }
+
+  uintb offset;
+  Varnode *root = recoverC166PointerRoot(address,offset);
+  if (root == (Varnode *)0)
+    return (Datatype *)0;
+  Datatype *rootType = root->getTypeDefFacing();
+  PcodeOp *rootUse = root->loneDescend();
+  if (rootUse != (PcodeOp *)0) {
+    Datatype *readType = root->getTypeReadFacing(rootUse);
+    if (readType->getMetatype() == TYPE_PTR)
+      rootType = readType;
+  }
+  Datatype *fieldType = selectC166FarPointerSourceField(rootType,offset,data,
+							segdef,hasDeclaredType);
+  if (fieldType != (Datatype *)0 || hasDeclaredType)
+    return fieldType;
+
+  if (!root->isWritten() || root->getDef()->code() != CPUI_SEGMENTOP ||
+      root->getDef()->numInput() != 3)
+    return (Datatype *)0;
+  PcodeOp *sourceSegment = root->getDef();
+  uintb innerOffset;
+  Varnode *innerRoot = recoverC166PointerRoot(sourceSegment->getIn(2),innerOffset);
+  if (innerRoot == (Varnode *)0 ||
+      offset > ~((uintb)0) - innerOffset)
+    return (Datatype *)0;
+  vector<pair<Varnode *,Varnode *> > active;
+  C166FarPointerPairEvidence source = proveC166FarPointerPair(data,segdef,
+				sourceSegment->getIn(1),innerRoot,active,0);
+  if (!source.related || source.whole == (Varnode *)0)
+    return (Datatype *)0;
+  Datatype *wholeType = recoverC166CallOutputType(data,source.whole);
+  if (wholeType == (Datatype *)0)
+    wholeType = source.whole->getTypeDefFacing();
+  return selectC166FarPointerSourceField(wholeType,offset + innerOffset,data,
+						segdef,hasDeclaredType);
+}
