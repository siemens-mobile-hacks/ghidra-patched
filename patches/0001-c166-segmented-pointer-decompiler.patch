+{
+  if (op == (const PcodeOp *)0 || op->code() != CPUI_PTRSUB || op->numInput() < 2)
+    return Address();
+  const Varnode *encoding = op->getIn(1);
+  if (!encoding->isConstant())
+    return Address();
