+/// \class RulePieceFarPointer
+/// \brief Convert a typed base:offset PIECE into a SEGMENTOP
+///
+/// A SegmentOp with far-pointer support describes an alternate pointer whose
+/// high-level representation is the concatenation of a base and near pointer.
+/// Once type recovery proves that a PIECE has this pointer type, express that
+/// relationship with the architecture's SEGMENTOP instead of printing a raw
+/// CONCAT.
+void RulePieceFarPointer::getOpList(vector<uint4> &oplist) const
+
+{
+  oplist.push_back(CPUI_PIECE);
+}
+
+int4 RulePieceFarPointer::applyOp(PcodeOp *op,Funcdata &data)
+
+{
+  Varnode *outvn = op->getOut();
+  Datatype *outtype = outvn->getTypeDefFacing();
+  if (outtype->getMetatype() != TYPE_PTR) return 0;
+  TypePointer *ptrtype = (TypePointer *)outtype;
+  AddrSpace *spc = ptrtype->getSpace();
+  if (spc == (AddrSpace *)0)
+    spc = data.getArch()->getDefaultDataSpace();
+  SegmentOp *segdef = data.getArch()->userops.getSegmentOp(spc->getIndex());
+  if (segdef == (SegmentOp *)0 || !segdef->hasFarPointerSupport()) return 0;
+  if (op->getIn(0)->getSize() != segdef->getBaseSize()) return 0;
+  if (op->getIn(1)->getSize() != segdef->getInnerSize()) return 0;
+  if (outvn->getSize() != segdef->getBaseSize() + segdef->getInnerSize()) return 0;
+
+  data.opInsertInput(op,data.newVarnodeSpace(spc),0);
+  data.opSetOpcode(op,CPUI_SEGMENTOP);
+  return 1;
+}
