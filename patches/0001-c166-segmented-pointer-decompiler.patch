+/// Retrieve the SegmentOp definition matching an internal CPUI_SEGMENTOP.
+/// Multiple definitions may target the same address space but use different
+/// input or output sizes.  The first definition remains the canonical one for
+/// pointer-size and resolver properties.
+/// \param op is the internal CPUI_SEGMENTOP
+/// \return the matching definition, or null
+SegmentOp *UserOpManage::getSegmentOp(const PcodeOp *op) const
+
+{
+  AddrSpace *spc = op->getIn(0)->getSpaceFromConst();
+  int4 baseSize = op->getIn(1)->getSize();
+  int4 innerSize = op->getIn(2)->getSize();
+  int4 outputSize = op->getOut()->getSize();
+  for(int4 i=0;i<segmentoplist.size();++i) {
+    SegmentOp *segmentDef = segmentoplist[i];
+    int4 expectedBaseSize = segmentDef->getBaseSize();
+    if (expectedBaseSize == 0)
+      expectedBaseSize = 4;	// Internal SEGMENTOP always has an explicit base input
+    if (segmentDef->getSpace() == spc &&
+	expectedBaseSize == baseSize &&
+	segmentDef->getInnerSize() == innerSize &&
+	segmentDef->getOutputSize() == outputSize)
+      return segmentDef;
+  }
+  return (SegmentOp *)0;
+}
