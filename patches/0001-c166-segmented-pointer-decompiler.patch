+  if (entry == (SymbolEntry *)0)
+    return Address();
+  Address symbolAddress = entry->getAddr();
+  AddrSpace *spc = symbolAddress.getSpace();
+  SegmentOp *segdef = glb->getSegmentOp(spc);
+  if (segdef == (SegmentOp *)0 || !segdef->hasFarPointerSupport() ||
+      op->getOut() == (const Varnode *)0 || op->getOut()->getSize() != spc->getAddrSize())
+    return Address();
+  uintb physicalOffset = AddrSpace::byteToAddress(symbolAddress.getOffset(),
