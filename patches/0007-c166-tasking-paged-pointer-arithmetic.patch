+  Varnode *inner = stripC166FarPointerCasts(op->getIn(2));
+  if (!inner->isWritten())
+    return (Varnode *)0;
+  PcodeOp *maskop = inner->getDef();
+  if (maskop->code() != CPUI_INT_AND)
+    return (Varnode *)0;
+  int4 valueSlot;
+  if (maskop->getIn(0)->isConstant() &&
+      maskop->getIn(0)->getOffset() == 0x3fff)
+    valueSlot = 1;
+  else if (maskop->getIn(1)->isConstant() &&
+           maskop->getIn(1)->getOffset() == 0x3fff)
+    valueSlot = 0;
+  else
+    return (Varnode *)0;
+
+  vector<C166PagedPointerTerm> terms;
+  uintb constant = 0;
+  if (!collectC166PagedPointerTerms(maskop->getIn(valueSlot),terms,constant,0) ||
+      terms.empty())
+    return (Varnode *)0;
+
+  Varnode *lowWhole = (Varnode *)0;
+  int4 pointerTerm = -1;
+  Varnode *highWhole = recoverC166FarPointerWhole(op->getIn(1),
+						  segdef->getInnerSize(),segdef->getBaseSize());
+  for(int4 i=0;i<(int4)terms.size();++i) {
+    if (terms[i].scale != 1)
+      continue;
+    Varnode *candidate = recoverC166FarPointerWhole(terms[i].vn,0,
+						     segdef->getInnerSize());
+    if (candidate == (Varnode *)0 || candidate != highWhole)
+      continue;
+    if (pointerTerm >= 0)
+      return (Varnode *)0;
+    pointerTerm = i;
+    lowWhole = candidate;
+  }
+  if (lowWhole == (Varnode *)0) {
+    for(int4 i=0;i<(int4)terms.size();++i) {
+      if (terms[i].scale != 1)
+	continue;
+
+      vector<pair<Varnode *,Varnode *> > active;
+      C166FarPointerPairEvidence evidence = proveC166FarPointerPair(data,segdef,
+	  op->getIn(1),terms[i].vn,active,0);
+      if (!evidence.related || !evidence.typedOrigin)
+	continue;
+      if (pointerTerm >= 0)
+	return (Varnode *)0;
+      if (evidence.whole == (Varnode *)0) {
+	Datatype *type = inferC166FarPointerType(op,data,segdef);
+	if (type == (Datatype *)0)
+	  continue;
+	evidence.whole = buildC166FarPointerValue(op,data,
+	    stripC166FarPointerCasts(op->getIn(1)),
+	    stripC166FarPointerCasts(terms[i].vn),type);
+	if (evidence.whole == (Varnode *)0)
+	  continue;
+      }
+      pointerTerm = i;
+      lowWhole = evidence.whole;
+    }
+  }
+  if (lowWhole == (Varnode *)0) {
+    for(int4 i=0;i<(int4)terms.size();++i) {
+      if (terms[i].scale != 1)
+	continue;
+      Varnode *candidate = recoverC166FarPointerLoadPair(op,data,segdef,
+							 op->getIn(1),terms[i].vn);
+      if (candidate == (Varnode *)0)
+	continue;
+      if (pointerTerm >= 0)
+	return (Varnode *)0;
+      pointerTerm = i;
+      lowWhole = candidate;
+    }
+  }
+  if (lowWhole == (Varnode *)0 || pointerTerm < 0)
+    return (Varnode *)0;
+  Datatype *type = recoverC166CallOutputType(data,lowWhole);
+  if (type != (Datatype *)0) {
+    if (type->getMetatype() != TYPE_PTR ||
+	((TypePointer *)type)->getPtrTo()->getMetatype() == TYPE_CODE ||
+	getC166TaskingClassicLargeSegment(data,type) != segdef)
+      return (Varnode *)0;
+  }
+  else
+    type = lowWhole->getTypeDefFacing();
+  SegmentOp *typedSegment = getC166TaskingClassicLargeSegment(data,type);
+  if (typedSegment != segdef) {
+    if (lowWhole->isTypeLock())
+      return (Varnode *)0;
+    Datatype *inferredType = inferC166FarPointerType(op,data,segdef);
+    if (inferredType == (Datatype *)0)
+      return (Varnode *)0;
+    PcodeOp *typedCopy = data.newOp(1,op->getAddr());
+    data.opSetOpcode(typedCopy,CPUI_COPY);
+    data.newUniqueOut(lowWhole->getSize(),typedCopy);
+    data.opSetInput(typedCopy,lowWhole,0);
+    data.opInsertBefore(typedCopy,op);
+    typedCopy->getOut()->updateType(inferredType);
+    lowWhole = typedCopy->getOut();
+    type = inferredType;
+    typedSegment = segdef;
+  }
+  TypePointer *pointerType = (TypePointer *)type;
+  if (pointerType->getPtrTo()->getMetatype() == TYPE_CODE)
+    return (Varnode *)0;
+
+  Varnode *result = lowWhole;
+  if (constant != 0) {
+    PcodeOp *addop = data.newOpBefore(op,CPUI_PTRSUB,result,
+				      data.newConstant(result->getSize(),constant));
+    addop->getOut()->updateType(type);
+    result = addop->getOut();
+  }
+  for(int4 i=0;i<(int4)terms.size();++i) {
+    if (i == pointerTerm)
+      continue;
+    Datatype *termType = terms[i].vn->getTypeDefFacing();
+    if (termType->getMetatype() == TYPE_PTR)
+      return (Varnode *)0;
+    Varnode *term = extendC166PagedPointerTerm(op,data,terms[i].vn,
+					       result->getSize());
+    if (term == (Varnode *)0)
+      return (Varnode *)0;
+    if (terms[i].scale != 1) {
+      PcodeOp *multop = data.newOpBefore(op,CPUI_INT_MULT,term,
+					 data.newConstant(term->getSize(),terms[i].scale));
+      term = multop->getOut();
+    }
+    PcodeOp *addop = data.newOpBefore(op,CPUI_INT_ADD,result,term);
+    addop->getOut()->updateType(type);
+    result = addop->getOut();
+  }
+  return result;
+}
