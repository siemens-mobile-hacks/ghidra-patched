+static Varnode *buildC166FarPointerValue(PcodeOp *follow,Funcdata &data,
+					 Varnode *high,Varnode *low,
+					 Datatype *type);
+
+/// Rejoin a far pointer loaded as two adjacent words.  TASKING Classic emits
+/// separate OFFSET/PAGE loads from pointer fields; unlike SUBPIECEs, these have
+/// no pre-existing whole Varnode for RuleSegment to recover.
+static Varnode *recoverC166FarPointerLoadPair(PcodeOp *segmentOp,Funcdata &data,
+					      SegmentOp *segdef,Varnode *high,Varnode *low)
+
+{
+  high = stripC166FarPointerCasts(high);
+  low = stripC166FarPointerCasts(low);
+  if (!high->isWritten() || !low->isWritten() ||
+      high->getSize() != segdef->getBaseSize() ||
+      low->getSize() != segdef->getInnerSize())
+    return (Varnode *)0;
+  PcodeOp *highLoad = high->getDef();
+  PcodeOp *lowLoad = low->getDef();
+  if (highLoad->code() != CPUI_LOAD || lowLoad->code() != CPUI_LOAD ||
+      highLoad->getIn(0)->getSpaceFromConst() !=
+					 lowLoad->getIn(0)->getSpaceFromConst())
+    return (Varnode *)0;
+  if (!areAdjacentC166LoadAddresses(highLoad->getIn(1),lowLoad->getIn(1),
+					    segdef->getInnerSize()))
+    return (Varnode *)0;
+
+  Datatype *type = inferC166FarPointerType(segmentOp,data,segdef);
+  if (type == (Datatype *)0)
+    return (Varnode *)0;
+  PcodeOp *wholeLoad = data.newOp(2,segmentOp->getAddr());
+  data.opSetOpcode(wholeLoad,CPUI_LOAD);
+  data.newUniqueOut(segdef->getBaseSize() + segdef->getInnerSize(),wholeLoad);
+  data.opSetInput(wholeLoad,lowLoad->getIn(0),0);
+  data.opSetInput(wholeLoad,lowLoad->getIn(1),1);
+  data.opInsertBefore(wholeLoad,segmentOp);
+  wholeLoad->getOut()->updateType(type,true,false);
+  return wholeLoad->getOut();
+}
+
+struct C166PagedPointerTerm {
+  Varnode *vn;
+  uintb scale;
+};
+
+/// Flatten the unsigned OFFSET expression of a paged C166 address.  Only
+/// addition and the pointer forms already produced by the decompiler are
+/// traversed; all other arithmetic remains an opaque scalar term.
+static bool collectC166PagedPointerTerms(Varnode *vn,
+					 vector<C166PagedPointerTerm> &terms,
+					 uintb &constant,int4 depth)
+
+{
+  if (depth >= 8 || terms.size() >= 8)
+    return false;
+  vn = stripC166FarPointerCasts(vn);
+  if (vn->isConstant()) {
+    if (vn->getOffset() > 0x3fff - constant)
+      return false;
+    constant += vn->getOffset();
+    return true;
+  }
+  if (!vn->isWritten()) {
+    terms.push_back({ vn, 1 });
+    return true;
+  }
+  PcodeOp *def = vn->getDef();
+  if (def->code() == CPUI_INT_ADD && def->numInput() == 2)
+    return collectC166PagedPointerTerms(def->getIn(0),terms,constant,depth+1) &&
+      collectC166PagedPointerTerms(def->getIn(1),terms,constant,depth+1);
+  if (def->code() == CPUI_PTRSUB && def->numInput() == 2 &&
+      def->getIn(1)->isConstant()) {
+    uintb offset = def->getIn(1)->getOffset();
+    if (offset > 0x3fff - constant)
+      return false;
+    constant += offset;
+    return collectC166PagedPointerTerms(def->getIn(0),terms,constant,depth+1);
+  }
+  if (def->code() == CPUI_PTRADD && def->numInput() == 3 &&
+      def->getIn(2)->isConstant()) {
+    uintb scale = def->getIn(2)->getOffset();
+    if (scale == 0 || scale > 0x3fff ||
+        !collectC166PagedPointerTerms(def->getIn(0),terms,constant,depth+1))
+      return false;
+    if (def->getIn(1)->isConstant()) {
+      uintb index = def->getIn(1)->getOffset();
+      if (index > (0x3fff - constant) / scale)
+        return false;
+      constant += index * scale;
+    }
+    else {
+      if (terms.size() >= 8)
+        return false;
+      terms.push_back({ stripC166FarPointerCasts(def->getIn(1)), scale });
+    }
+    return true;
+  }
+  terms.push_back({ vn, 1 });
+  return true;
+}
+
+/// Widen one unsigned OFFSET term without changing its value.
+static Varnode *extendC166PagedPointerTerm(PcodeOp *follow,Funcdata &data,
+					   Varnode *vn,int4 size)
+
+{
+  vn = stripC166FarPointerCasts(vn);
+  if (vn->getSize() > size)
+    return (Varnode *)0;
+  if (vn->getSize() == size)
+    return vn;
+  PcodeOp *extop = data.newOp(1,follow->getAddr());
+  data.opSetOpcode(extop,CPUI_INT_ZEXT);
+  data.newUniqueOut(size,extop);
+  data.opSetInput(extop,vn,0);
+  data.opInsertBefore(extop,follow);
+  return extop->getOut();
+}
+
+/// Build the raw PAGE:OFFSET pointer value without CPUI_PIECE.  PIECE marks
+/// both inputs as precision halves and can trigger global double-width rewrites
+/// across large phi graphs.  The equivalent unsigned expression is local and
+/// leaves the original SSA variables untouched.
+static Varnode *buildC166FarPointerValue(PcodeOp *follow,Funcdata &data,
+					 Varnode *high,Varnode *low,
+					 Datatype *type)
+
+{
+  int4 size = high->getSize() + low->getSize();
+  Varnode *wideHigh = extendC166PagedPointerTerm(follow,data,high,size);
+  Varnode *wideLow = extendC166PagedPointerTerm(follow,data,low,size);
+  if (wideHigh == (Varnode *)0 || wideLow == (Varnode *)0)
+    return (Varnode *)0;
+  PcodeOp *shift = data.newOpBefore(follow,CPUI_INT_LEFT,wideHigh,
+				    data.newConstant(size,low->getSize() * 8));
+  PcodeOp *combine = data.newOpBefore(follow,CPUI_INT_OR,shift->getOut(),wideLow);
+  combine->getOut()->updateType(type);
+  return combine->getOut();
+}
+
+/// Recognize TASKING Classic Large's page-local OFFSET arithmetic feeding an
+/// EXTP dereference.  The generated machine code preserves PAGE while masking
+/// OFFSET to 14 bits.  Rebuild the typed far pointer for identity, constant,
+/// and scalar-indexed forms instead of exposing representation arithmetic.
+static Varnode *recoverC166PagedPointer(PcodeOp *op,Funcdata &data,
+					SegmentOp *segdef)
+
+{
+  if (!data.getArch()->hasProcessorProperty("c166.abi","tasking-classic-large") ||
+      !segdef->hasFarPointerSupport() || segdef->getBaseSize() != 2 ||
+      segdef->getInnerSize() != 2)
+    return (Varnode *)0;
+  if (findC166FarPointerMemoryUse(op->getOut()) == (PcodeOp *)0)
+    return (Varnode *)0;
