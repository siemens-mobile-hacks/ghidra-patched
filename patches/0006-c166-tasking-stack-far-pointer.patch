diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc
index 204abd17..87317a6e 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc
@@ -20,6 +20,29 @@
 
 namespace ghidra {
 
+/// Return the segmented data-space definition only for the C166 TASKING Classic
+/// large model.  ArchitectureGhidra reports a generic architecture id, so the
+/// module's large-model processor specs provide explicit processor and compiler
+/// identifiers as properties.
+static SegmentOp *getC166TaskingClassicLargeSegment(Funcdata &data,Datatype *type)
+
+{
+  Architecture *glb = data.getArch();
+  if (!glb->hasProcessorProperty("c166.abi","tasking-classic-large") ||
+      type == (Datatype *)0 ||
+      type->getMetatype() != TYPE_PTR)
+    return (SegmentOp *)0;
+  TypePointer *pointerType = (TypePointer *)type;
+  AddrSpace *spc = pointerType->getSpace();
+  if (spc == (AddrSpace *)0)
+    spc = glb->getDefaultDataSpace();
+  SegmentOp *segdef = glb->userops.getSegmentOp(spc->getIndex());
+  if (segdef == (SegmentOp *)0 || !segdef->hasFarPointerSupport() ||
+      type->getSize() != segdef->getBaseSize() + segdef->getInnerSize())
+    return (SegmentOp *)0;
+  return segdef;
+}
