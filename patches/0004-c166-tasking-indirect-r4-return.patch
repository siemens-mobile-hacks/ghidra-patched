+/// \brief Get the logical return value data-type
+///
+/// TASKING C166 Classic returns doubles and structures through a near pointer
+/// in R4 without receiving a hidden return pointer.  The physical prototype
+/// therefore carries an indirect pointer, while the source-level return type is
+/// the pointed-to type.  The Java protocol encoder only transmits indirect
+/// return storage for the C166 TASKING Classic large model, so the flag itself
+/// is the architecture-scoped contract.
+Datatype *FuncProto::getOutputType(void) const
+
+{
+  ProtoParameter *outparam = store->getOutput();
+  Datatype *type = outparam->getType();
+  if (!outparam->isIndirectStorage() || type->getMetatype() != TYPE_PTR)
+    return type;
+  return ((TypePointer *)type)->getPtrTo();
+}
